{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset_bundle_case_v1",
  "title": "Dataset Bundle Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "turns"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "class": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "file": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}